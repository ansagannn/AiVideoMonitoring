FROM node:22-alpine AS frontend-builder
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./
ENV VITE_FREE_DEMO=1
RUN npm run build

FROM python:3.12-slim AS model-builder
WORKDIR /models
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir ultralytics==8.3.228 onnx==1.17.0 onnxslim opencv-python-headless
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
RUN python -c "from ultralytics import YOLO; YOLO('yolov8n.pt').export(format='onnx', imgsz=320, opset=12, simplify=True, dynamic=False)"

FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libglib2.0-0 libgl1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/requirements-demo.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/app ./app
COPY --from=model-builder /models/yolov8n.onnx ./models/yolov8n.onnx
COPY --from=frontend-builder /frontend/dist ./frontend/dist
ENV AI_MONITORING_DB_PATH=/tmp/monitoring.db PYTHONUNBUFFERED=1 AI_MONITOR_DISABLE_INFERENCE=0 AI_MONITOR_YOLO_MODEL=/app/models/yolov8n.onnx AI_MONITOR_PUBLIC_ONLY=1 AI_MONITOR_YOLO_AUTO_DOWNLOAD=0
EXPOSE 10000
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]
